# Copiar este archivo a .env (no versionado) junto a docker-compose.final.yml
# antes de correr: docker compose -f docker-compose.final.yml up -d --build

# Obligatorio para docker-compose.final.yml (Gateway no arranca sin esto).
# Cualquier string largo y random sirve para desarrollo/demo.
JWT_SECRET=cambienme_por_un_secreto_largo_y_random

# Opcional. Tiempo de vida del JWT emitido en /auth/login (formato de la
# libreria `ms`: "1h", "30m", "10s", etc). Si se omite, usa 1h por defecto.
JWT_EXPIRES_IN=1h

# Opcional. DSN real del proyecto de Sentry del equipo. Si se deja vacio,
# Sentry simplemente no reporta (los 4 servicios siguen funcionando igual).
# NUNCA commitear el valor real aca ni en el codigo: quien tenga el DSN
# puede enviar eventos falsos a esa cuenta.
SENTRY_DSN=

# Opcional. Etiqueta el ambiente en los eventos de Sentry.
SENTRY_ENVIRONMENT=production
